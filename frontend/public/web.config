<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="GeoWorkbench API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8081/api/{R:1}" />
        </rule>
        <rule name="GeoWorkbench Health Proxy" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="http://127.0.0.1:8081/health" />
        </rule>
        <rule name="GeoWorkbench Corebox Assets Proxy" stopProcessing="true">
          <match url="^assets/corebox/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8081/assets/corebox/{R:1}" />
        </rule>
        <rule name="GeoWorkbench SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <outboundRules rewriteBeforeCache="true">
        <rule name="GeoWorkbench revalidate shell" preCondition="Shell response">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, max-age=0, must-revalidate" />
        </rule>
        <rule name="GeoWorkbench immutable hashed assets" preCondition="Hashed frontend asset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="GeoWorkbench branding cache" preCondition="Branding asset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=86400" />
        </rule>
        <preConditions>
          <preCondition name="Shell response">
            <add input="{REQUEST_URI}" pattern="^/(?:$|index\.html$|sw\.js$|manifest\.webmanifest$)" />
          </preCondition>
          <preCondition name="Hashed frontend asset">
            <add input="{REQUEST_URI}" pattern="^/assets/[^/]+-[A-Za-z0-9_-]+\.(?:js|css|woff2|png|svg)$" />
          </preCondition>
          <preCondition name="Branding asset">
            <add input="{REQUEST_URI}" pattern="^/branding/" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
