GEOWORKBENCH_DATABASE_URL=sqlite:///./geoworkbench_dev.db
GEOWORKBENCH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production examples:
# GEOWORKBENCH_DATABASE_URL=postgresql+psycopg://geoworkbench:password@db-server:5432/geoworkbench
# GEOWORKBENCH_UPLOAD_STORAGE=local
# GEOWORKBENCH_UPLOAD_ROOT=D:/GeoWorkbench/data/uploads
# GEOWORKBENCH_PUBLIC_BASE_URL=https://geoworkbench.example.com

# Object storage. Use local filesystem by default; set provider=s3 for MinIO/S3.
GEOWORKBENCH_OBJECT_STORAGE_PROVIDER=local
GEOWORKBENCH_S3_ENDPOINT_URL=http://127.0.0.1:9000
GEOWORKBENCH_S3_BUCKET=geoworkbench
GEOWORKBENCH_S3_REGION=us-east-1
GEOWORKBENCH_S3_ACCESS_KEY=geoworkbench
GEOWORKBENCH_S3_SECRET_KEY=geoworkbench123
GEOWORKBENCH_S3_FORCE_PATH_STYLE=true
GEOWORKBENCH_S3_URL_MODE=proxy

# Future AI provider settings
GEOWORKBENCH_AI_PROVIDER=disabled
GEOWORKBENCH_AI_MODEL=
GEOWORKBENCH_AI_BASE_URL=
GEOWORKBENCH_AI_API_KEY=

# Local auth / mobile OTP demo
GEOWORKBENCH_AUTH_TOKEN_HOURS=12
GEOWORKBENCH_MOBILE_OTP_MINUTES=10
GEOWORKBENCH_PUSH_PROVIDER=disabled
GEOWORKBENCH_PUSH_FCM_SERVER_KEY=
GEOWORKBENCH_PUSH_APNS_KEY_ID=
GEOWORKBENCH_PUSH_APNS_TEAM_ID=
GEOWORKBENCH_PUSH_APNS_BUNDLE_ID=
